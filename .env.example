# LLM mode: mock (no key required) or real (OpenAI-compatible API)
# Real eval: uv run python -m eval.run_llm_eval --mode real
LLM_MODE=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Local paths
DB_PATH=data/runtime/product_intel.db
REPORT_DIR=reports
EXCEL_PATH=data/source/amazon_products.xlsx
EXCEL_OUT=data/exports/amazon_products.xlsx
RAW_DIR=data/raw

# Amazon collector
# replay = parse cached HTML; live = curl_cffi, then Playwright fallback
AMAZON_SOURCE=replay
AMAZON_MARKETPLACE=amazon.com
AMAZON_TIMEOUT=30
AMAZON_RETRIES=1
AMAZON_DELAY=6
# US residential proxy recommended for buybox prices, e.g. http://user:pass@host:port
AMAZON_PROXY=
AMAZON_HEADLESS=true
AMAZON_USER_AGENT=
